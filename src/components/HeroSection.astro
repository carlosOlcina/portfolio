---
const CONTACT_EMAIL = 'carlosolcina23@gmail.com';
---

<section class="hero animate-fade-in-up" id="overview">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__headline">
        Desarrollo digital en la intersección de{' '}
        <span class="hero__headline-accent">ingeniería e IA.</span>
      </h1>
      <p class="hero__tagline">
        Ingeniero Full-Stack &amp; Arquitecto de Software IA. Desarrollo web de
        alto rendimiento con React, Next.js y TypeScript.
      </p>
      <div class="hero__actions">
        <a class="hero__cta hero__cta--primary" href="#projects">
          <span class="hero__cta-label">Ver Proyectos</span>
          <svg
            class="hero__icon hero__icon--arrow"
            viewBox="0 -960 960 960"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z"></path>
          </svg>
        </a>
        <button
          class="hero__cta hero__cta--secondary"
          id="copy-email-hero-btn"
          type="button"
          data-email={CONTACT_EMAIL}
        >
          <svg
            class="hero__icon hero__icon--copy"
            viewBox="0 -960 960 960"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z"></path>
          </svg>
          <span class="hero__cta-label">Copiar Correo</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 10;
    padding-block: 5rem;
    border-bottom: 1px solid rgba(199, 210, 254, 0.35);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 7rem;
    }
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
    max-width: 56rem;
    margin-inline: auto;
    position: relative;
    z-index: 10;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__headline {
    font-family: var(--font-headline);
    font-weight: var(--text-headline-xl-weight);
    font-size: var(--text-headline-xl-size);
    line-height: var(--text-headline-xl-line-height);
    letter-spacing: -0.025em;
    color: var(--color-slate-900);
  }

  @media (min-width: 768px) {
    .hero__headline {
      font-size: 4.25rem;
    }
  }

  .hero__headline-accent {
    display: inline-block;
    font-style: italic;
    font-family: var(--font-headline);
    font-weight: 300;
    background-image: linear-gradient(
      to right,
      var(--color-primary),
      var(--color-indigo-600),
      var(--color-violet-500)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.05));
  }

  .hero__tagline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-body-md-size);
    line-height: 1.625;
    letter-spacing: 0.025em;
    color: var(--color-slate-700);
    max-width: 42rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-xl);
    background-color: rgba(255, 255, 255, 0.45);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 4px 20px rgba(79, 70, 229, 0.04);
  }

  @media (min-width: 768px) {
    .hero__tagline {
      font-size: 1.05rem;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-full);
    font-size: var(--text-label-md-size);
    line-height: var(--text-label-md-line-height);
    font-weight: var(--text-label-md-weight);
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    text-decoration: none;
  }

  .hero__cta--primary {
    color: #ffffff;
    background-image: linear-gradient(
      to right,
      var(--color-indigo-600),
      var(--color-primary),
      var(--color-indigo-600)
    );
    border: 1px solid rgba(53, 37, 205, 0.4);
    box-shadow: 0 4px 20px rgba(79, 70, 229, 0.3);
  }

  .hero__cta--primary:hover {
    background-image: linear-gradient(
      to right,
      var(--color-indigo-700),
      var(--color-indigo-600),
      var(--color-indigo-700)
    );
    box-shadow: 0 10px 32px rgba(79, 70, 229, 0.45);
  }

  .hero__cta--primary:active {
    transform: scale(0.95);
  }

  .hero__cta--secondary {
    color: var(--color-slate-800);
    background-color: rgba(255, 255, 255, 0.5);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .hero__cta--secondary:hover {
    border-color: var(--color-indigo-300);
    background-color: rgba(255, 255, 255, 0.75);
    box-shadow: 0 6px 22px rgba(79, 70, 229, 0.12);
  }

  .hero__cta--secondary:active {
    transform: scale(0.95);
  }

  .hero__cta-label {
    letter-spacing: 0.025em;
  }

  .hero__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero__icon--copy {
    color: var(--color-primary);
  }

  .hero__cta--primary:hover .hero__icon--arrow {
    transform: translateY(0.125rem);
  }

  .hero__cta--secondary:hover .hero__icon--copy {
    transform: rotate(12deg);
  }
</style>

<script>
  import { copyToClipboard, showToast } from '../scripts/clipboard';

  const button = document.querySelector<HTMLButtonElement>(
    '#copy-email-hero-btn',
  );
  const toast = document.getElementById('toast');
  const toastMessage = document.getElementById('toast-text');

  if (button && toast && toastMessage) {
    button.addEventListener('click', () => {
      const email = button.dataset.email;
      if (!email) return;
      void copyToClipboard(email, () =>
        showToast({ container: toast, message: toastMessage }),
      );
    });
  }
</script>
